# ============================================================================
# ReturnGuard — .gitignore
#
# Rule of thumb: everything the README's "Run it from a clean checkout" flow
# GENERATES is ignored; everything it NEEDS is committed. After a fresh clone the
# only file you create by hand is your two API keys in `.env` — and even `.env`
# itself is written for you by `python scripts/gen_secrets.py` from `.env.example`.
# ============================================================================

# ---- secrets & local env -------------------------------------------------------
# Real secrets. `.env` is generated by scripts/gen_secrets.py; you only fill in
# OPENAI_API_KEY / GROQ_API_KEY. `frontend/.env.local` is generated too.
.env
.env.local
.env.*.local
frontend/.env.local
# ...but the templates they are generated from MUST stay in the repo:
!.env.example
!frontend/.env.local.example
# stray key material
*.pem
*.key
*.p12
*.pfx

# ---- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ---- Node / Next.js (frontend runs on the host) ----------------------------
node_modules/
.next/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts
# Next 16 (Turbopack) regenerates these on every `npm run dev`:
frontend/AGENTS.md
frontend/CLAUDE.md
# legacy generated API client path (the real one, frontend/lib/api/schema.ts, is committed)
frontend/lib/api/generated.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- ML artifacts — all regenerated by `make m4-setup` ---------------------
# `make dataset` output:
ml/data/
# `make train` output (model + card + metrics, versioned). Keep the dir, drop
# the contents — train.py recreates ml/registry/<version>/ and ml/registry/LATEST.
ml/registry/*
!ml/registry/.gitkeep
# one-time detector bake-off (ADR-0002) — sample images + downloaded candidates
ml/detector_bakeoff/models/
ml/detector_bakeoff/sample/

# ---- runtime / operational output -----------------------------------------
# `make backup` target:
backups/
# logs
*.log
scripts/_dlq_worker*.log
# written by verify_m3_dlq.py while it runs:
docker-compose.dlqtest.yml
# written by scripts/mcp_setup.py (ContextForge virtual-server ids for reference):
infra/mcp-gateway/mcp_setup.json
# local review artifact from seed/fetch_images.py (the product images themselves ARE committed):
seed/images/_contact_sheet.png

# ---- Docker nested-bind-mount mountpoints ---------------------------------
# docker-compose.override.yml mounts ./docs, ./seed, ./ml INSIDE ./backend and
# ./worker (which are themselves mounted at /app). Docker creates these empty
# dirs on the host on every `docker compose up`. They are not source.
backend/docs/
backend/seed/
backend/ml/
worker/docs/
worker/seed/
worker/ml/

# ---- OS / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
