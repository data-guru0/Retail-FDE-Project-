# ReturnGuard frontend — copy to .env.local and fill AUTH_SECRET.
#   cp frontend/.env.local.example frontend/.env.local
# `scripts/gen_secrets.py` writes this file for you from the repo root.
# AUTH_SECRET is the only value you must set; a random 32+ char string.
# The KEYCLOAK_CLIENT_SECRET below matches the returnguard-web client in
# infra/keycloak/realm-export.json (a fixed local-dev fixture, not a real secret).

AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
KEYCLOAK_ISSUER=http://localhost:8081/realms/returnguard
KEYCLOAK_CLIENT_ID=returnguard-web
KEYCLOAK_CLIENT_SECRET=VsfOvtq11751C1m5YpVIMP_e6dwLBxin
BACKEND_URL=http://localhost:8000
