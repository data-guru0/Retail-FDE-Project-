# ReturnGuard — bootstrap env. Copy to .env and fill in.
# .env is git-ignored. Its only job is to bootstrap Vault + start the
# infra container images that read credentials at boot. The backend and
# worker read every secret from Vault, not from here.

# --- paid API keys (required from Milestone 3 on) ---
OPENAI_API_KEY=
GROQ_API_KEY=

# --- generated infra credentials (any strong random string) ---
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
NEXTAUTH_SECRET=
CONTEXTFORGE_JWT_SECRET=
BIFROST_ADMIN_TOKEN=

LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=

# --- fixed local values (fine to leave as-is) ---
POSTGRES_USER=returnguard
POSTGRES_DB=returnguard
MINIO_ROOT_USER=returnguard
KEYCLOAK_ADMIN=admin
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN_ID=root
